# Use a separate PostgreSQL database for each environment. SSL is required in production.
DATABASE_URL=postgresql://user:password@host:5432/retail_development?sslmode=require

# Recommended for providers with a private CA such as Aiven. Base64-encoded PEM.
DATABASE_CA_CERT_BASE64=

# Local alternative to the base64 value above. Do not use a workstation path on Vercel.
DATABASE_CA_CERT_PATH=

# Public origin used for security checks and absolute URLs. No trailing slash.
APP_URL=http://localhost:3000

# Comma-separated login emails allowed to access the platform-owner console.
# Keep this list limited to trusted Retail Logic operators.
PLATFORM_ADMIN_EMAILS=owner@example.com

# Optional observability metadata.
LOG_LEVEL=info
VERCEL_ENV=development

# Local development seed only. Never define this in Preview or Production.
SEED_PASSWORD=replace-with-a-strong-development-password

# Optional isolated Playwright environment. Never point E2E at production.
E2E_BASE_URL=
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_CASHIER_EMAIL=
E2E_CASHIER_PASSWORD=
E2E_PRODUCT_SKU=

# Dedicated migrated integration-test database only. Never use Production.
TEST_DATABASE_URL=
TEST_DATABASE_CA_CERT_BASE64=
